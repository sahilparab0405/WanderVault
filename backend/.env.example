PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/wandervault?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key

# Frontend URL for CORS (Vercel deployment URL)
FRONTEND_URL=https://wandervault-frontend.vercel.app

# Keep-alive ping URL for Render free-tier (prevents cold starts)
KEEP_ALIVE_URL=https://wandervault-backend.onrender.com

# Email config for budget alerts (optional — skipped if not set)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
